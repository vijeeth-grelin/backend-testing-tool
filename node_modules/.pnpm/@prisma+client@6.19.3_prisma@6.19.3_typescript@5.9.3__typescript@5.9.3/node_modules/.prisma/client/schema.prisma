// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // ADMIN or USER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  baseUrl     String? // Centralized Base URL for all collections in this project
  collections Collection[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Collection {
  id          String   @id @default(uuid())
  name        String // Version name (e.g. v1, v2) or descriptive name
  description String?
  type        String // SWAGGER or POSTMAN
  fileName    String?
  data        String // JSON string of the collection content
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy  String // User ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
